# Smart Agricultural Procurement Platform - Environment Variables Template
# Copy this file to .env or set environment variables in your server setup.
# NEVER commit your actual API key to version control.

# Google Maps Platform Routes API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Route Cache Duration in Seconds (Default: 60)
GOOGLE_ROUTE_CACHE_SECONDS=60

# Application Server Port
SERVER_PORT=8080

# Database Configuration (Optional, defaults to H2 in-memory or local MySQL)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_procurement
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root
